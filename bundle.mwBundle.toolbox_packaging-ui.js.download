:host {
    display: inline-flex;
    font-size: 16px;
    box-sizing: border-box;
    width:100%;
    height:100%;
    --mw-whitespace-mwAlignment: normal;
    --mw-fontSize-alignment: 12px;
    --mw-fontFamily-alignment: var(--mw-fontFamily);
    --mw-color-alignment: var(--mw-color-primary);
}

:host .mwAlignmentLayoutWrapper {
    display: flex;
}

:host .mwAlignmentIcon {
    padding: 2px;
    align-self: stretch;
    display: flex;
    align-items: center;
}

:host .mwAlignmentText {
    padding: 2px;
    white-space: var(--mw-whitespace-mwAlignment);
    color: var(--mw-color-alignment);
    font-size: var(--mw-fontSize-alignment);
    font-family: var(--mw-fontFamily-alignment);
}

:host([verticalAlignment='top']), :host([verticalAlignment='top']) .mwAlignmentLayoutWrapper {
    align-items:flex-start;
}
:host([verticalAlignment='middle']), :host([verticalAlignment='middle']) .mwAlignmentLayoutWrapper {
    align-items:center;
}
:host([verticalAlignment='bottom']), :host([verticalAlignment='bottom']) .mwAlignmentLayoutWrapper {
    align-items:flex-end;
}

:host([iconAlignment='left']) .mwAlignmentLayoutWrapper, :host([iconAlignment='right']) .mwAlignmentLayoutWrapper {
    flex-direction: row;
}
:host([iconAlignment='top']) .mwAlignmentLayoutWrapper, :host([iconAlignment='bottom']) .mwAlignmentLayoutWrapper {
    flex-direction: column;
}
:host([iconAlignment='left']) .mwAlignmentIcon, :host([iconAlignment='top']) .mwAlignmentIcon {
    order: 0;
}
:host([iconAlignment='right']) .mwAlignmentIcon, :host([iconAlignment='bottom']) .mwAlignmentIcon {
    order: 1;
}
:host([horizontalAlignment='left']), :host([horizontalAlignment='left']) .mwAlignmentIcon {
    justify-content: left;
}
:host([horizontalAlignment='right']), :host([horizontalAlignment='right']) .mwAlignmentIcon {
    justify-content: right;
}
:host([horizontalAlignment='center']), :host([horizontalAlignment='center']) .mwAlignmentIcon {
    justify-content: center;
}
:host([horizontalAlignment='left']) .mwAlignmentText {
    text-align: left;
}
:host([horizontalAlignment='center']) .mwAlignmentText {
    text-align: center;
}
:host([horizontalAlignment='right']) .mwAlignmentText {
    text-align: right;
}

:host([iconAlignment='center']) .mwAlignmentLayoutWrapper {
    position: relative;
}
:host([iconAlignment='leftmargin']) .mwAlignmentLayoutWrapper, :host([iconAlignment='rightmargin']) .mwAlignmentLayoutWrapper {
    width: 100%;
    position: relative;
}
:host([iconAlignment='leftmargin']) .mwAlignmentLayoutWrapper{
    justify-content: flex-start;
}
:host([iconAlignment='rightmargin']) .mwAlignmentLayoutWrapper{
    justify-content: flex-end;
}
:host([iconAlignment='center']) .mwAlignmentIcon {
    position: absolute;
    inset: 0;
    justify-content: center;
}
:host([iconAlignment='leftmargin'][horizontalAlignment='center']) .mwAlignmentIcon, :host([iconAlignment='rightmargin'][horizontalAlignment='center']) .mwAlignmentIcon {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
}
:host([iconAlignment='leftmargin'][horizontalAlignment='left']) .mwAlignmentIcon {
    position: static;
    order: 0;
}
:host([iconAlignment='rightmargin'][horizontalAlignment='right']) .mwAlignmentIcon, :host([iconAlignment='rightmargin'][horizontalAlignment='left']) .mwAlignmentIcon {
    position: static;
    order: 2;
}
:host([iconAlignment='rightmargin']) .mwAlignmentText, :host([iconAlignment='leftmargin']) .mwAlignmentText {
    flex-grow: 1;
}
:host([iconAlignment='center']) .mwAlignmentText {
    z-index: 1;
}`;return f.default=c,f.default},h,T),h.exports=E},"mw-browser-utils/BrowserUtils":async(h,T,t)=>{var g,E;g=[t(t.dj.r.absMids["dojo/_base/lang"]),t(t.dj.r.absMids["dojo/_base/sniff"]),t(t.dj.r.absMids["dojo/dom-class"])],E=t.dj.d(g,function(p,f,c){var d=window,l=null;return{supportsLocalStorage:function(){var a=d&&typeof d.localStorage!==void 0&&d.localStorage!==null;if(a)try{d.localStorage.setItem("motw.test.local.storage","0"),d.localStorage.removeItem("motw.test.local.storage")}catch{a=!1}return a},_hasNewIE:function(a){var n;return a&&!f("ie")&&f("trident")>0?n=parseFloat(a.split("rv:")[1]):a&&a.indexOf("Edge")>0?n="Edge "+parseFloat(a.split("Edge/")[1]):n="",n},_getBrowserInfo:function(a){var n,s={BROWSER:"OTHER",BROWSER_VER:"OTHER"},e,i={IE:"Microsoft Internet Explorer",FF:"Mozilla Firefox",Chrome:"Google Chrome",Safari:"Apple Safari"};if(n=this._hasNewIE(a),n)s.BROWSER=i.IE,s.BROWSER_VER=n.toString();else for(e in i)if(i.hasOwnProperty(e)&&f(e.toLowerCase())){n=f(e.toLowerCase()),s.BROWSER=i[e],s.BROWSER_VER=n.toString(),(e==="Chrome"||e==="Safari")&&(s.WEBKIT_VER=f("webkit").toString());break}return s},getSystemInfo:function(){var a={},n={};try{a.DEVICE="",a.LOCALE=d.navigator.language,a.OS=d.navigator.platform,a.PLATFORM=d.navigator.platform,a.SCREEN_RESOLUTION=d.screen.width+"x"+d.screen.height,a.WINDOW_RESOLUTION=d.innerWidth+"x"+d.innerHeight,a.USER_AGENT=d.navigator.userAgent,n=this._getBrowserInfo(d.navigator.appVersion),a=p.mixin(a,n)}catch{}return a},setClassName:function(a,n){if(c.add(a,"mw_type_"+(n.type||"unknownType")),c.add(a,"mw_type_Component"),n.name){var s="mw_name_"+(n.name.trim().replace(/[^a-zA-Z0-9]/g,"_")||"NO_NAME");c.contains(a,s)||(a.className=a.className.replace(/mw_name_[^ ]*/,""),c.add(a,s))}},isInFocus:function(a){return typeof d.document.activeElement!="unknown"?a===d.document.activeElement:!1},getScrollbarWidth:function(){if(l===null){var a=document.createElement("div");a.className="scrollbar-measure",a.style.width="100px",a.st