\uC2B5\uB2C8\uB2E4. \uC774 \uC791\uC5C5\uC744 \uC0AC\uC6A9\uD558\uC5EC ${0} \uBC30\uD3EC\uC758 \uBAA8\uB4E0 \uD2B9\uC131\uC744 \uC0AC\uC6A9\uC790 \uC9C0\uC815\uD558\uACE0 \uAD00\uB9AC\uD569\uB2C8\uB2E4.",setupCompilerDocumentFromUpgrade:"\uC774\uC81C ${0} \uD504\uB85C\uC81D\uD2B8\uB294 \uCEF4\uD30C\uC77C\uB7EC \uC791\uC5C5\uC785\uB2C8\uB2E4. \uC774 ${1} \uC791\uC5C5\uC744 \uC0AC\uC6A9\uD558\uC5EC \uC560\uD50C\uB9AC\uCF00\uC774\uC158 \uD328\uD0A4\uC9D5\uC744 \uC0AC\uC6A9\uC790 \uC9C0\uC815\uD569\uB2C8\uB2E4.",setupCompilerDocumentNew:"\uD328\uD0A4\uC9D5 \uC808\uCC28\uB97C \uAD00\uB9AC\uD560 \uC218 \uC788\uB3C4\uB85D \uD558\uB294 \uC0C8 ${0} \uC791\uC5C5\uC774 \uC0DD\uC131\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uC5EC\uB7EC \uD0C0\uAE43\uC5D0 \uBC30\uD3EC\uD558\uAE30 \uC704\uD574 \uD544\uC694\uD55C \uB9CC\uD07C \uCD94\uAC00 \uC791\uC5C5\uC744 \uC0DD\uC131\uD558\uC2ED\uC2DC\uC624.",setupCompilerRediscover:"\uCEF4\uD30C\uC77C\uB7EC \uC791\uC5C5 \uAD00\uB9AC\uC790\uB97C \uC0AC\uC6A9\uD558\uC5EC \uCEF4\uD30C\uC77C\uB7EC \uC791\uC5C5\uC744 \uAD00\uB9AC\uD558\uC2ED\uC2DC\uC624. \uC791\uC5C5\uC744 \uB2E4\uC2DC \uC5F4\uB824\uBA74 <b>\uD504\uB85C\uC81D\uD2B8</b> \uD0ED\uC5D0\uC11C <b>\uCEF4\uD30C\uC77C\uB7EC \uC791\uC5C5 \uAD00\uB9AC\uC790</b>\uB97C \uC120\uD0DD\uD558\uC2ED\uC2DC\uC624.",setupCompilerSelectedFilesFromApp:"\uC571\uC774 \uC790\uB3D9\uC73C\uB85C \uCEF4\uD30C\uC77C\uB7EC \uC791\uC5C5\uC5D0 \uCD94\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4.",setupCompilerSelectedFilesFromUpgrade:"\uC774\uC804 \uD504\uB85C\uC81D\uD2B8 \uBC84\uC804\uC758 \uBA54\uC778 MATLAB \uD30C\uC77C\uC774 \uC790\uB3D9\uC73C\uB85C \uCEF4\uD30C\uC77C\uB7EC \uC791\uC5C5\uC5D0 \uCD94\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4.",setupCompilerSelectedFilesFromUpgradeLibrary:"\uC774\uC804 \uD504\uB85C\uC81D\uD2B8 \uBC84\uC804\uC758 \uB0B4\uBCF4\uB0B8 MATLAB \uD568\uC218\uAC00 \uC790\uB3D9\uC73C\uB85C \uCEF4\uD30C\uC77C\uB7EC \uC791\uC5C5\uC5D0 \uCD94\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4.",setupCompilerSelectedFilesNew:"\uBC30