                height: var(--mw-height-progress-indicator-small);
                width: var(--mw-height-progress-indicator-small);
            }

            :host([size='medium' i]) {
                height: var(--mw-height-progress-indicator-medium);
                width: var(--mw-height-progress-indicator-medium);
            }

            :host([size='large' i]) {
                height: var(--mw-height-progress-indicator-large);
                width: var(--mw-height-progress-indicator-large);
            }

            :host([size='xlarge' i]) {
                height: var(--mw-height-progress-indicator-xlarge);
                width: var(--mw-height-progress-indicator-xlarge);
            }

            .mw-progress-indicator-svg {
                background-color: transparent;
                position: absolute;
                height: 100%;
                width: 100%;
            }

            .mw-progress-indicator-gutter {
                fill: none;
                stroke: var(--gutter-color);
                stroke-opacity: 1;
            }

            .mw-progress-indicator-progress-border {
                stroke: var(--mw-backgroundColor-tertiary);
            }

            .mw-progress-indicator {
                fill: none;
                stroke-dashoffset: 0;
                transition: stroke-dasharray 0.15s linear;
                transform: rotate(-0.${s.INDETERMINATE_PERCENT_COMPLETION}turn);
                isolation: isolate;
            }

            .outer-group {
                fill: var(--mw-borderColor-primary);
            }

            @keyframes spinnerAnimation {
                from {
                    transform: rotate(0deg);
                }
                to {
                    transform: rotate(360deg);
                }
            }

            .indeterminate {
                animation: spinnerAnimation 1.3s infinite linear;
            }

            :host([value='0']) .mw-progress-indicator {
                display: none;
            }
