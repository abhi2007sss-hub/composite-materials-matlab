.deploymentToolboxInfo{
    width: 100%
}
/*OUTPUT LOCATIONS*/

/*Miscellaneous spacing for rendeirng output sections in dialogs*/
/*a widget description vertical spacing, seems like it may be more useful in more areas than current use in FolderSelector */
.deployedToolboxNameLabel {
    margin-bottom: 4px;
}

.deployedToolboxNameLabel{
    min-height: 20px; /* for placeholder so dialogs containign this widget can know a good height*/
    width:100%;
    color: var(--mw-color-primary);
    margin-top: 0px;
}

.toolboxNameWidget {
    padding-bottom:5px;
}
/** -----------------------Required Add-Ons widget----------------------------**/
.toolboxAddonsEntryWidget[isfex="true"] .deploymentAddonDownLoadURLCell{
    display: none;
}

.toolboxAddonsEntryWidget[isfex="false"] .deploymentAddonRange{
    display: none;
}

/**If no header, then show no table either**/
.toolboxAddonsWidget[hasEntries = "0"]  .toolboxAddonsList{
    display:none;
}

.toolboxAddonsDescription{
    margin-bottom: 5px;
    color: var(--mw-color-secondary);
}

.toolboxAddonsWidget{
    margin-bottom: 10px;
}

.deploymentAddonRangeConnection{
    vertical-align: super;
    color: var(--mw-color-secondary);
}

.deploymentAddonDownLoadURLField, .deploymentAddonDownLoadURLCell{
    width: 100% !important;
}

/**To limit width of range combo boxes**/
.deploymentAddonRangeBox{
    max-width: 110px;
    display: inline-block
}

.deploymentAddonInclusionCell{
    text-align: center;
    vertical-align: middle;
    padding: 15px;
    /* best to keep checkbox cells a uniform width*/
    width: 20px;
}

.toolboxAdditionalSoftwareList{
  
    /* border: 1px solid var(--mw-borderColor-primary); */
    background-color: var(tertiary);
}


.toolboxAddonsEntryWidget:nth-child(even) {
    background-color: var(--mw-backgroundColor-primary);
}


.toolboxAddonsEntryWidget {
/*     border: 1px solid var(--mw-borderColor-primary); */
    width: 100%;
/*     background-color: var(--mw-backgroundColor-secondary); */
}

.toolboxAddonsEntryWidget + .toolboxAddonsEntryWidget{
/*     border-top: 0px; */
  margin-top:5px;
}

/**internal data table should take full width of containing cell**/
.deploymentAddonDataTable{
    width: 100%;
}

.deploymentAddonTitle{
    color: var(--mw-color-primary);
    font-weight: bold;
}

.deploymentAddonVersion{
    color: var(--mw-color-secondary);
    font-weight: bold;
}

/** spacinf above author line and range/URL widgets **/
.deploymentAddonInfoLine{
    padding-top: 5px;
}

.deploymentAddonAuthor{
    color: var(--mw-color-secondary);
}

/**Addon details to the right of the image, includes name, ver, author, url, range**/
.deploymentAddonDataCell{
    padding: 5px;
    padding-left: 10px;
    width: 100%;
}

.deploymentAddonImageCell{
    vertical-align: middle;
    width: 60px;
}

.deploymentAddonImage{
    width: 50px;
    height: 50px;
    background-color: var(--mw-backgroundColor-secondary);
    border: 1px solid var(--mw-borderColor-primary);
}

.deploymentAddonsDetailsCell{
    text-align: center;
    vertical-align: middle;
    padding: 15px;
    max-width: 80px;
}

.toolboxAddonsList{
    border: solid var(--mw-borderColor-primary) 1px;
    background-color: var(--mw-backgroundColor-tertiary);
  
}

/*------------3p additional SW-----------------------------*/
.toolboxAdditionalSoftwareWidget{
    color: var(--mw-color-primary);
}

/**If no header, then show no table either**/
.toolboxAdditionalSoftwareWidget[hasEntries = "0"]  .toolboxAdditionalSoftwareList{
    display:none;
}

.toolboxAdditionalSoftwareDescription{
    color: var(--mw-color-secondary);
}


.deployment3pLabel {
    width: 90px;
    display: inline-block;
    margin-top: 10px;
}

.toolboxAdditionalSoftwareList{
    margin-top: 5px;
    margin-bottom: 5px;
    background-color: var(--mw-backgroundColor-tertiary);
}

.toolboxSoftwareEntryWidget {
/*     border: solid var(--mw-borderColor-primary) 1px; */
    padding: 13px;
    /* background-color: lightgrey; */
    color: var(--mw-color-primary);
  
}

.toolboxSoftwareEntryWidget:nth-child(even) {
    background-color: var(--mw-backgroundColor-primary);
}

.toolboxSoftwareEntryWidgetErrorMessage {
     color: var(--mw-color-error);

}

.toolboxSoftwareEntryWidget[valid="true"] .toolboxSoftwareEntryWidgetErrorMessage{
    display: none;
}


.toolboxSoftwareEntryWidget[valid="false"] .toolboxSoftwareEntryWidgetErrorMessage{
    width: 100%;
}

.toolboxSoftwareEntryWidget[valid="true"] {
  border: 1px solid var(--mw-borderColor-primary);
  border-bottom: 0px;
}

.toolboxSoftwareEntryWidget:last-child {
    border-bottom:  1px solid var(--mw-borderColor-primary);
  /* background-color:green; */
}

.toolboxSoftwareEntryWidget[valid="false"] {
    border: 1px solid var(--mw-borderColor-error);
    background-color: var(--mw-backgroundColor-secondary-error)
}


/*when second one is proper, we don't show two borders
same if there are two invalid ones in a row*/
.toolboxSoftwareEntryWidget + .toolboxSoftwareEntryWidget[valid="true"], .toolboxSoftwareEntryWidget[valid="false"] + .toolboxSoftwareEntryWidget[valid="false"]  {
  border-top: 0px;
}

.deployment3pField{
  margin:3px;
}


.toolboxSoftwareEntryWidget + .toolboxSoftwareEntryWidget{
/*     border-top: 0px; */
/*   margin-top:10px; */
}

.toolboxSoftwareEntryWidget {
    display: flex;
    flex-wrap: wrap;
    column-gap: 10px;
    row-gap: 10px;
}

.toolboxSoftwareEntryWidgetTable {
    flex-grow: 1;
    flex-basis: 100px;
    min-width: 0px;
}

.deployment3pRemoval {
    flex-basis: 20px;
    min-width: 0px;
}


.deployment3pCell {
    display: flex; /* Enables flexbox layout */
    flex-wrap: wrap; /* Allows items to wrap to the next line */
    align-items: center; /* Centers items vertically */
}

.deployment3pLabel {
    width: 95px; /* Fixed width for the span */
    flex-shrink: 0; /* Prevents the span from shrinking */
    padding-right: 5px;
}

.deployment3pLabelPlatform{
    text-align: right;
    width: auto;
}

.deployment3pField {
    flex-grow: 1; /* Allows the input to grow and fill the remaining space */
    min-width: 0; /* Allows the input to shrink below its default size if necessary */
    flex-basis: 100px; /*this will encourage the fields to become small when necessary, otherwise, it wraps too soon, especially for the SW name*/
}

/*copied*/
.deployment3pNameAndPlatformSection {
    display: flex; /* Enables flex layout for direct children */
    flex-wrap: wrap; /* Allows items to wrap */
    column-gap: 10px;
}

.deployment3pTopCell {
    display: flex; /* Enables flexbox layout within each cell */
    flex-wrap: wrap; /* Allows items within the cell to wrap */
    align-items: center; /* Centers items vertically within the cell */
    flex: 1; /* Allows cells to grow and share the available space */ 
    max-width: 100%;
    flex-basis: 250px; /*cut to two rows early, at 250px, otherwise looks weird with lower rows*/
}

/** -----------------------mlapps and Custom apps----------------------------**/
.toolboxAppName{
  color: var(--mw-color-secondary);
  color: var(--mw-color-primary);
}

.toolboxAppsDescription{
  color: var(--mw-color-secondary);
}

.toolboxAppEntryWidget{
    width: 100%;
}

.toolboxAppsListHeader{
  margin-top:10px;
  margin-bottom:5px;
  color: var(--mw-color-primary);
}
.toolboxAppSummary{
    color: var(--mw-color-secondary);
    margin-right: 15px;
}

.toolboxAppEntryWidget:nth-child(even) {
    background-color: var(--mw-backgroundColor-primary);
}


  .toolboxAppsList {
/*     padding-bottom:10px; */
    display: flex;
    flex-direction: column;
    width: 100%; /* Adjust based on parent/container size */
  }
  
  .toolboxAppEntryWidget {
    display: flex;
    flex-wrap: wrap; /* Allow items to wrap */
  }
  
  .toolboxAppInfo {
    display: flex;
    overflow: hidden;
    padding: 2px;
    align-items: center;
    flex: 0 1 auto; /* Allow flex items to shrink but not grow */
  }
  
  .toolboxAppIcon {
    width: 24px; /* Fixed width for certain columns */
    flex: 0 0 24px; /* Don't grow, don't shrink, stay at 20px */
    padding-left: 15px;
    padding-right: 15px;
  }

  .toolboxAppEdit, .toolboxAppRemoval {
    width: 45px; /* Fixed width for certain columns */
    flex: 0 0 45px; /* Don't grow, don't shrink, stay at 20px */
  } 

  .toolboxAppEntryWidget[appType="mlapp"] .toolboxAppName {
    flex-basis: 10%; /* Adjust this value based on your needs */
    flex-grow: 1;
  }

  .toolboxAppEntryWidget[appType="custom"] .toolboxAppName {
    flex-basis: 10%; /* Adjust this value based on your needs */
    flex-grow: 1;
  }

  .toolboxAppEntryWidget[appType="mlapp"] .toolboxAppSummary {
    flex-basis: 20%; /* Adjust this value based on your needs */
    flex-grow: 1;
    shrink: 1;
  }

  .toolboxAppEntryWidget[appType="custom"] .toolboxAppSummary {
    display:none;
    width:0px;
    shrink: 1;
  }

/* Right-align the last column when wrapping occurs */
.toolboxAppRemoval, .toolboxAppEdit {
  margin-left: auto;
  padding-bottom:2px;
  /* text-align: right; */
}

.toolboxAppsListHeader[hasEntries = "0"]{
    display:none;
}
/** -----------------------MATLAB Path and Java Class Path widget----------------------------**/

.toolboxPathsPlaceholder[toggle = "true"]{
    /* display:none; */
}

.toolboxPathsPlaceholder[toggle = "false"]{
    display:none;
}

.toolboxPathWidget{
    margin-top: 5px;
    margin-bottom: 10px;
}

.deploymentMATLABPathSection{
  margin-bottom: 40px;

}

.deploymentJavaClassPathSection{
    
}

.toolboxAppsWidget{
  margin-bottom:10px;
}

/**If no header, then show no table either**/
.toolboxAppsListHeader[hasEntries = "0"] + .toolboxAppsList{
    display:none;
}

.toolboxAppsList{
    border: solid var(--mw-borderColor-primary) 1px;
    background-color: var(--mw-backgroundColor-tertiary);
}

.toolboxPathsPlaceholder{
    color: var(--mw-color-secondary);
}

.deploymentRemovePathButton{
    float: right;
}

.supportedPlatformsWidget .compilerRadioSelection {
    display: inline-flex !important; /* Enables flexbox layout */
    flex-wrap: wrap; /* Allows items to wrap to the next line */
    gap: 10px
}

.specificReleasesContainer {
    display: flex !important; /* Enables flexbox layout */
    flex-wrap: wrap; /* Allows items to wrap to the next line */
    gap: 5px;
    color: var(--mw-color-primary);
    align-items: center;
}

.gettingStartedDialogBody {
    display: flex;
    flex-direction: column;
    width: 550px;
    gap: 20px;
}

.deploymentFileTreeParent {
    overflow-y: hidden;
}

.deploymentFileTree {
    border: var(--mw-borderColor-secondary) 1px solid;
    margin: 15px;
    padding: 3px 0px 3px 3px;
    max-height: 350px;
    background-color: var(--mw-backgroundColor-input);
    overflow-y: auto;
}

.deploymentFileTreeNode[deploymenttoolboxisexcluded="1"] {
    color: var(--mw-color-secondary);
    opacity: 55%;
}

.deploymentFileTree .mw-tree .mw-tree-scroll-component {
    /* height: 100%; */
    /* position: relative; */
    overflow: initial;
}

.deploymentFileTree .mw-tree.treeContainer {
    max-height: 350px;
    overflow: auto !important;
}

.deploymentFileTree[visible = "true"]{
    visibility: visible;
}

.deploymentFileTree[visible = "false"]{
    visibility: hidden;
    margin-top: 0px;
