/* ---- Theme: Product ---- */    
:host {
    --mw-paddingTop-button: 2px;
    --mw-paddingRight-button: 4px;
    --mw-paddingBottom-button: 2px;
    --mw-paddingLeft-button: 4px;
    --mw-borderWidth-button: 1px;
    --mw-borderTopWidth-button: 1px;
    --mw-borderRightWidth-button: 1px;
    --mw-borderBottomWidth-button: 1px;  
    --mw-borderLeftWidth-button: 1px;               
    --mw-borderStyle-button: solid;
    --mw-borderColor-button: var(--mw-borderColor-primary);
    --mw-borderRadius-button: 5px;
    --mw-marginTop-button: 0;
    --mw-marginRight-button: 0;
    --mw-marginBottom-button: 0;
    --mw-marginLeft-button: 0;
    --mw-backgroundColor-button: var(--mw-backgroundColor-primary);
    --mw-boxSizing-button: border-box;    
    --mw-color-button: var(--mw-color-primary);
    --mw-cursor-button: default;
    --mw-display-button: inline-block;        
    --mw-fontFamily-button: var(--mw-fontFamily);    
    --mw-fontSize-button: 12px;
    --mw-lineHeight-button: inherit;     
    --mw-outline-button: none;
    --mw-outlineOffset-button: 0;
    --mw-userSelect-button: none;    
    --mw-verticalAlign-button: top;    
    --mw-whitespace-button: normal; 
    
    /* Adding the CSS Styles */
    display: var(--mw-display-button);
    box-sizing: var(--mw-boxSizing-button);
    height: var(--mw-height-button, auto);
    width: var(--mw-width-button, auto);

    /* States */    
    --mw-hoverBorderColor-button: var(--mw-borderColor-hover);
    --mw-hoverBackgroundColor-button: var(--mw-backgroundColor-hover);

    --mw-focussedBorderColor-button: var(--mw-borderColor-focus);
    --mw-focussedBoxShadow-button: none;

    --mw-activeBorderColor-button: var(--mw-borderColor-primary);
    --mw-activeBackgroundColor-button: var(--mw-backgroundColor-active);
    --mw-activeBoxShadow-button: inset 0 1px 0 0 var(--mw-activeBoxShadowColor-button);

    --mw-opacity-disabled-button: 0.35;

    /* Toggle Buttons and States */
    --mw-backgroundColor-toggleon-button: var(--mw-backgroundColor-toggleOn);
    /* stylelint-disable */
    --mw-boxshadow-toggleon-button: inset 0 1px 0 0 rgb(0 0 0 / 15%);
    /* stylelint-enable */

    --mw-hoverBorderColor-toggleon-button: var(--mw-borderColor-toggleOn-hover);
    --mw-hoverBackgroundColor-toggleon-button: var(--mw-backgroundColor-toggleOn-hover);
}



/* ---- Theme: Web Standards ---- */
:host([class*="btn-color-"]) {
  --mw-width-button: auto;
  --mw-height-button: auto;
  --mw-paddingTop-button: max(8px, 0.625rem);
  --mw-paddingRight-button: 0.875rem;
  --mw-paddingBottom-button: calc(var(--mw-paddingTop-button) - 1px);
  --mw-paddingLeft-button: 0.875rem;
  --mw-borderWidth-button: 1px;
  --mw-borderTopWidth-button: 1px;
  --mw-borderRightWidth-button: 1px;
  --mw-borderBottomWidth-button: 1px;
  --mw-borderLeftWidth-button: 1px;
  --mw-borderStyle-button: solid;
  --mw-borderColor-button: var(--mw-color-transparent);
  --mw-borderRadius-button: var(--mw-borderRadius);
  --mw-marginTop-button: 0;
  --mw-marginRight-button: 0;
  --mw-marginBottom-button: 0;
  --mw-marginLeft-button: 0;
  --mw-backgroundColor-button: var(--mw-color-transparent);
  --mw-boxSizing-button: border-box;
  --mw-color-button: var(--mw-color-primary);
  --mw-cursor-button: pointer;
  --mw-display-button: inline-block;
  --mw-fontFamily-button: var(--mw-fontFamily);
  --mw-fontSize-button: 1.0rem;
  --mw-lineHeight-button: 1.00;
  --mw-outline-button: 2px solid var(--mw-focusOutline-color);
  --mw-outlineOffset-button: 2px;
  --mw-userSelect-button: none;
  --mw-verticalAlign-button: middle;
  --mw-whitespace-button: normal;

  /* States */
  --mw-hoverBackgroundColor-button: var(--mw-color-transparent);

  --mw-focussedBorderColor-button: var(--mw-hoverBackgroundColor-button);
  --mw-focussedBoxShadow-button: none;

  --mw-activeBorderColor-button: var(--mw-hoverBackgroundColor-button);
  --mw-activeBackgroundColor-button: var(--mw-hoverBackgroundColor-button);
  --mw-activeBoxShadow-button: none;

  --mw-opacity-disabled-button: var(--mw-opacity-disabled); 
}


/* WS: Solid Colors */
:host([class*="btn-color-"]:not(.outline-btn)) {
  --mw-color-button: var(--mw-color-button-primary);   

  /* States */
  --mw-borderColor-button: var(--mw-backgroundColor-button);
  --mw-hoverBorderColor-button: var(--mw-hoverBackgroundColor-button);
}

:host(.btn-color-orange:not(.outline-btn)) {
  --mw-backgroundColor-button: var(--mw-backgroundColor-button-orange);
  --mw-hoverBackgroundColor-button: var(--mw-backgroundColor-button-orange-hover);
}

:host(.btn-color-blue:not(.outline-btn)) {
  --mw-backgroundColor-button: var(--mw-backgroundColor-button-blue);
  --mw-hoverBackgroundColor-button: var(--mw-backgroundColor-button-blue-hover);
}

:host(.btn-color-green:not(.outline-btn)) {
  --mw-backgroundColor-button: var(--mw-backgroundColor-button-green);
  --mw-hoverBackgroundColor-button: var(--mw-backgroundColor-button-green-hover);
}

:host(.btn-color-gray:not(.outline-btn)) {
  --mw-backgroundColor-button: var(--mw-backgroundColor-button-gray);
  --mw-hoverBackgroundColor-button: var(--mw-backgroundColor-button-gray-hover);
}


/* WS: Outline Colors */
:host([class*="btn-color-"].outline-btn) {
  --mw-color-button: var(--mw-borderColor-button);
  --mw-hoverBackgroundColor-button: var(--mw-hoverBorderColor-button);
}

:host(.btn-color-orange.outline-btn) {
  --mw-borderColor-button: var(--mw-color-buttonOutline-orange);
  --mw-hoverBorderColor-button: var(--mw-color-buttonOutline-orange-hover);
}

:host(.btn-color-blue.outline-btn) {
  --mw-borderColor-button: var(--mw-color-buttonOutline-blue);
  --mw-hoverBorderColor-button: var(--mw-color-buttonOutline-blue-hover);
}

:host(.btn-color-green.outline-btn) {
  --mw-borderColor-button: var(--mw-color-buttonOutline-green);
  --mw-hoverBorderColor-button: var(--mw-color-buttonOutline-green-hover);
}

:host(.btn-color-gray.outline-btn) {
  --mw-borderColor-button: var(--mw-color-buttonOutline-gray);
  --mw-hoverBorderColor-button: var(--mw-color-buttonOutline-gray-hover);;
}


/* WS: Sizes */
:host(.btn-xs) > .mwButton {
  --mw-paddingTop-button: 4px;
  --mw-paddingRight-button: 8px;
  --mw-paddingBottom-button: var(--mw-paddingTop-button);
  --mw-paddingLeft-button: var(--mw-paddingRight-button);
  --mw-fontSize-button: 12px;
}


:host(.btn-sm) > .mwButton {
  --mw-paddingTop-button: max(6px, 0.5rem);
  --mw-paddingRight-button: 0.75rem;
  --mw-paddingBottom-button: var(--mw-paddingTop-button);
  --mw-paddingLeft-button: var(--mw-paddingRight-button);
  --mw-fontSize-button: max(12px, 0.75rem);
}

:host(.btn-lg) > .mwButton {
  --mw-paddingTop-button: max(10px, 0.75rem);
  --mw-paddingRight-button: 1.125rem;
  --mw-paddingBottom-button: var(--mw-paddingTop-button);
  --mw-paddingLeft-button: var(--mw-paddingRight-button);
  --mw-fontSize-button: 1.125rem;
}


/* WS: Animation */
:host([class*="btn-color-"]) > .mwButton {
  transition: border-color 0.3s ease, background-color 0.3s ease, color 0.3s ease;
}


/* WS: States */
/* Hover */
:host([class*="btn-color-"].outline-btn) > .mwButton:hover,
:host([class*="btn-color-"].outline-btn) > .mwButton:focus,
:host([class*="btn-color-"].outline-btn) > .mwButton:active {
  --mw-color-button: var(--mw-color-button-primary); 
}

/* Focus */
:host([class*="btn-color-"]) > .mwButton:focus {
  --mw-backgroundColor-button: var(--mw-hoverBackgroundColor-button);
}

/* Disabled */
:host([class*="btn-color-"]) > button[disabled] {
  --mw-outline-button: none;
  --mw-outlineOffset-button: 0;  
}



/* ---- Button Styles ---- */
:host > .mwButton{
    width: 100%;
    height: 100%;
    padding-top: var(--mw-paddingTop-button);
    padding-right: var(--mw-paddingRight-button);
    padding-bottom: var(--mw-paddingBottom-button);
    padding-left: var(--mw-paddingLeft-button);
    border-width: var(--mw-borderWidth-button);
    border-top-width: var(--mw-borderTopWidth-button);
    border-right-width: var(--mw-borderRightWidth-button);
    border-bottom-width: var(--mw-borderBottomWidth-button);
    border-left-width: var(--mw-borderLeftWidth-button);
    border-style: var(--mw-borderStyle-button);
    border-color: var(--mw-borderColor-button);
    border-radius: var(--mw-borderRadius-button);
    margin-top: var(--mw-marginTop-button);
    margin-right: var(--mw-marginRight-button);
    margin-bottom: var(--mw-marginBottom-button);
    margin-left: var(--mw-marginLeft-button);
    background-color: var(--mw-backgroundColor-button);  
    color: var(--mw-color-button);
    cursor: var(--mw-cursor-button);    
    display: var(--mw-display-button);
    font-family: var(--mw-fontFamily-button);
    font-size: var(--mw-fontSize-button);
    line-height: var(--mw-lineHeight-button);    
    user-select: var(--mw-userSelect-button);
    -webkit-user-select: var(--mw-userSelect-button);
    vertical-align: var(--mw-verticalAlign-button);
    white-space: var(--mw-whitespace-button);
}

:host > .mwButton:hover {
    border-color: var(--mw-hoverBorderColor-button);
    background-color: var(--mw-hoverBackgroundColor-button);
}

:host > .mwButton:active {
    border-color: var(--mw-activeBorderColor-button);
    background-color: var(--mw-activeBackgroundColor-button);
    box-shadow: var(--mw-activeBoxShadow-button);
}

:host > .mwButton:focus {
    border-color: var(--mw-focussedBorderColor-button);
    box-shadow: var(--mw-focussedBoxShadow-button);
}

:host > .mwButton:focus-visible {
    outline: var(--mw-outline-button);
    outline-offset: var(--mw-outlineOffset-button);
}

:host > button[disabled].mwButton {
    outline: var(--mw-outline-button);
    opacity: var(--mw-opacity-disabled-button);
}

:host([disabled]) > .mwButton:hover,
:host > button[disabled]:hover {
    border-color: var(--mw-borderColor-button);
    background-color: var(--mw-backgroundColor-button);
    cursor: default;
}



/* ---- Toggle Button Styles ---- */
:host([checked]) > .mwButton {
    border-color: var(--mw-borderColor-button);
    background-color: var(--mw-backgroundColor-toggleon-button);
    box-shadow: var(--mw-boxshadow-toggleon-button);
}

:host([checked]) > .mwButton:hover {
    border-color: var(--mw-hoverBorderColor-toggleon-button);
    background-color: var(--mw-hoverBackgroundColor-toggleon-button);
}

:host([checked]) > .mwButton:focus {
    border-color: var(--mw-focussedBorderColor-button);
}

:host([checked]) > .mwButton:active {
    border-color: var(--mw-focussedBorderColor-button);
    background-color: var(--mw-activeBackgroundColor-button);
}
    
:host > .mwButton > mw-alignment {
    --mw-color-alignment: var(--mw-color-button);
    --mw-fontFamily-alignment: var(--mw-fontFamily-button);
    --mw-fontSize-alignment: var(--mw-fontSize-button);
    --mw-whitespace-mwAlignment: var(--mw-whitespace-button);
}`;return f.default=c,f.default},h,T),h.exports=E},"mw-button/enum/Type":async(h,T,t)=>{var g,E;g=[],E=t.dj.d(g,function(){"use strict";var p={};const f=Object.freeze({BUTTON:"button",SUBMIT_BUTTON:"submit",RESET_BUTTON:"reset"});return p.default=f,p.default},h,T),h.exports=E},"mw-checkbox/Checkbox":async(h,T,t)=>{var g,E;g=[t(t.dj.r.absMids["mw-widget-api/WidgetBase"]),t(t.dj.r.absMids["mw-widget-api/defineWidget"]),t(t.dj.r.absMids["mw-widget-api/facade/html"]),t(t.dj.r.absMids["mw-widget-api/facade/svg"]),t(t.dj.r.absMids["mw-widget-api/facade/directives/ifDefined"]),t(t.dj.r.absMids["mw-widget-api/facade/nothing"]),t(t.dj.r.absMids["mw-form-utils/validationController/ValidationController"]),t(t.dj.r.absMids["mw-form-utils/enums/ControllerCSSClassesEnum"]),t(t.dj.r.absMids["mw-checkbox/enum/CheckedEnum"]),t(t.dj.r.absMids["mw-checkbox/enum/EventEnum"]),t(t.dj.r.absMids["mw-checkbox/enum/PropertiesEnum"]),t(t.dj.r.absMids["mw-checkbox/enum/ClassEnum"]),t(t.dj.r.absMids["mw-label/Label"]),t(t.dj.r.absMids["mw-widget-api/facade/directives/ref"]),t(t.dj.r.absMids["mw-widget-api/facade/directives/createRef"])],E=t.dj.d(g,function(p,f,c,d,l,a,n,s,e,i,r,o,u,m,C){"use strict";var A=e.CHECKED_ENUM,y=i.EVENT,v=r.PROPERTIES_ENUM,S=o.CLASS_ENUM,D={};class M extends p{static get formAssociated(){return!0}constructor(){super(),this.checked=A.FALSE,this.disabled=!1,this.readOnly=!1,this.dirty=!1,this.validationState="normal",this._checkboxInputRef=C(),this._internals=this.attachInternals()}static get properties(){return{checked:{type:String,reflect:!0,converter:{fromAttribute:R=>R===A.TRUESTRING||R===A.FALSESTRING||R===""?R==="true"||R==="":R!==A.MIXED?!0:R,toAttribute:R=>typeof R=="boolean"?R===A.TRUE?"":null:R}},disabled:{type:Boolean,reflect:!0},readOnly:{type:Boolean,reflect:!0},name:{type:String,attribute:!0,reflect:!1},value:{type:String,attribute:!0,reflect:!1},labelledBy:{type:String,attribute:!0,reflect:!1},tabIndex:{type:Number,reflect:!0,attribute:!0},content:{type:S