\uC704\uD55C \uC6F9 \uC571 \uAD6C\uC131",previewPluginError:"\uD30C\uC77C \uD615\uC2DD\uC740 .mlappinstall \uB610\uB294 .mltbx\uC5EC\uC57C \uD569\uB2C8\uB2E4",progressMessageMatlabApp:"MATLAB \uC571 \uD328\uD0A4\uC9D5 \uC9C4\uD589\uB960",progressMessageStandaloneApp:"\uB3C5\uB9BD \uC2E4\uD589\uD615 \uC571 \uD328\uD0A4\uC9D5 \uC9C4\uD589\uB960",progressMessageWebApp:"\uC6F9 \uC571 \uD328\uD0A4\uC9D5 \uC9C4\uD589\uB960",projectFromFileError:"\uD504\uB85C\uC81D\uD2B8\uB97C \uB9CC\uB4E4 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uD504\uB85C\uC81D\uD2B8 \uB8E8\uD2B8 \uC704\uCE58\uAC00 \uC4F0\uAE30 \uAC00\uB2A5\uD558\uBA70, MATLAB \uB8E8\uD2B8 \uD3F4\uB354\uC5D0 \uC788\uC9C0 \uC54A\uC740\uC9C0 \uD655\uC778\uD558\uC2ED\uC2DC\uC624.",projectMustBeOpen:"A project must be open to use this function",projectShare:"\uD504\uB85C\uC81D\uD2B8\uB97C \uC0AC\uC6A9\uD558\uC5EC \uACF5\uC720",projectShareDialogTitle:"MATLAB \uD504\uB85C\uC81D\uD2B8\uB85C \uC571 \uACF5\uC720 \uAD00\uB9AC",projectShareText:"\uD2B9\uC815 \uC635\uC158\uC774 \uBCF4\uC774\uC9C0 \uC54A\uC2B5\uB2C8\uAE4C? \uACF5\uC720 \uC571\uC758 \uD2B9\uC815 \uC18D\uC131\uC740 MATLAB \uD504\uB85C\uC81D\uD2B8\uC758 \uC791\uC5C5\uC744 \uC0AC\uC6A9\uD574\uC57C\uB9CC \uAD6C\uC131\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.",readyToPackage:"\uC791\uC5C5\uC744 \uBC30\uD3EC\uD560 \uC900\uBE44\uAC00 \uB428",reanalyzeButtonLabel:"\uB2E4\uC2DC \uBD84\uC11D",saveInProject:"\uD504\uB85C\uC81D\uD2B8\uC5D0 \uC800\uC7A5",selectFile:"\uD30C\uC77C \uC120\uD0DD",selectFolder:"\uD3F4\uB354 \uC120\uD0DD",selectImage:"\uC774\uBBF8\uC9C0 \uC120\uD0DD",showCode:"\uCF54\uB4DC \uD45C\uC2DC",showLess:"\uAC04\uB2E8\uD788 \uD45C\uC2DC",showMore:"\uB354 \uBCF4\uAE30",splashScreen:"\uC2DC\uC791 \uD654\uBA74",subfolderErrorMessage:"\uD504\uB85C\uC81D\uD2B8\uAC00 \uC571 \uD3F4\uB354\uC758 \uD558\uC704 \uD3F4\uB354\uC5D0 \uC774\uBBF8 \uC874\uC7AC\uD558\uBBC0\uB85C \uD504\uB85C\uC81D\uD2B8\uB97C \uC0DD\uC131\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uAE30\uC874 \uD504\uB85C\uC81D\uD2B8\uB97C \uC81C\uAC70\uD558\uAC70\uB098 \uAE30\uC874 \uD504\uB85C\uC81D\uD2B8\uC5D0 \uC571\uC744 \uCD94\uAC00\uD558\uC2ED\uC2DC\uC624.",taskIsDeploying:"\uC791\uC5C5\uC774 \uBC30\uD3EC \uC911\uC785\uB2C8\uB2E4",toolbarPackageLabel:"\uD328\uD0A4\uC9C0 ${0}",toolboxAnalysisButtonDescription:"\uD234\uBC15\uC2A4 \uB0B4\uC6A9\uC744 \uB2E4\uC2DC \uBD84\uC11D\uD569\uB2C8\uB2E4",toolboxPackageButtonDescription:"\uD234\uBC15\uC2A4 \uC124\uCE58 \uD30C\uC77C\uC744 \uB9CC\uB4E4\uAE30 \uC704\uD574 \uD328\uD0A4\uC9D5\uD569\uB2C8\uB2E4",viewAnalysisLabel:"\uBD84\uC11D \uBCF4\uAE30",warningDefaultOutput:"${0}\uC774(\uAC00) \uD504\uB85C\uC81D\uD2B8 \uD3F4\uB354 \uC678\uBD80\uC5D0 \uC788\uC73C\uBBC0\uB85C \uCD9C\uB825 \uD3F4\uB354\uB85C \uC124\uC815\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uC791\uC5C5\uC5D0\uC11C\uB294 \uB514\uD3F4\uD2B8 \uCD9C\uB825 \uD3F4\uB354\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4.",warningMPSExcel:"\uD504\uB85C\uC81D\uD2B8\uB97C \uC0AC\uC6A9\uD558\uC5EC Production Server\uC6A9 Excel \uD074\uB77C\uC774\uC5B8\uD2B8\uB97C \uBE4C\uB4DC\uD558\uB294 \uAC83\uC740 \uB354 \uC774\uC0C1 \uC9C0\uC6D0\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. Production Server\uC6A9 \uBC30\uD3EC \uAC00\uB2A5\uD55C \uC544\uCE74\uC774\uBE0C\uB97C \uBE4C\uB4DC\uD558\uB3C4\uB85D \uD504\uB85C\uC81D\uD2B8\uAC00 \uC5C5\uB370\uC774\uD2B8\uB418\uC5C8\uC2B5\uB2C8\uB2E4.",warningMissingFile:"${0}\uC774(\uAC00) \uC874\uC7AC\uD558\uC9C0 \uC54A\uC73C\uBBC0\uB85C \uC791\uC5C5\uC5D0 \uCD94\uAC00\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",warningMissingToolboxFolder:"${0}\uC774(\uAC00) \uC874\uC7AC\uD558\uC9C0 \uC54A\uC73C\uBBC0\uB85C \uD234\uBC15\uC2A4 \uD3F4\uB354\uB85C \uC124\uC815\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",warningMultipleClasses:"\uC5EC\uB7EC \uAC1C\uC758 \uD074\uB798\uC2A4\uB294 \uB354 \uC774\uC0C1 \uC9C0\uC6D0\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uCCAB \uBC88\uC9F8 \uD074\uB798\uC2A4 \uC774\uB984\uC774 \uC0AC\uC6A9\uB429\uB2C8\uB2E4.",warningToolboxIgnore:'\uD234\uBC15\uC2A4\uC5D0\uC11C \uD30C\uC77C\uC744 \uC81C\uC678\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uD30C\uC77C "toolbox.ignore"\uAC00 \uC874\uC7AC\uD558\uACE0 \uD615\uC2DD\uC774 \uC62C\uBC14\uB978\uC9C0 \uD655\uC778\uD558\uC2ED\uC2DC\uC624.',warningTypeSafeAPI:"\uD615\uC2DD\uC774 \uC548\uC804\uD55C(type-safe) API\uB97C \uC0AC\uC6A9\uD558\uC5EC .NET \uC5B4\uC148\uBE14\uB9AC\uB97C \uBE4C\uB4DC\uD558\uB294 \uAC83\uC740 \uB354 \uC774\uC0C1 \uC9C0\uC6D0\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uC5B4\uC148\uBE14\uB9AC\uB294 \uD615\uC2DD\uC774 \uC548\uC804\uD55C \uC778\uD130\uD398\uC774\uC2A4\uB97C \uC0AC\uC6A9\uD558\uC5EC \uBE4C\uB4DC\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uB300\uC2E0 \uB370\uC774\uD130 \uBC30\uC5F4 \uC778\uD130\uD398\uC774\uC2A4\uC640 \uD568\uAED8 \uAC15\uD55C \uC720\uD615\uC744 \uC0AC\uC6A9\uD558\uB294 \uAC83\uC774 \uC88B\uC2B5\uB2C8\uB2E4.",warningUnlabeledFile:"${0}\uC774(\uAC00) \uD504\uB85C\uC81D\uD2B8 \uD3F4\uB354 \uC678\uBD80\uC5D0 \uC788\uC73C\uBBC0\uB85C \uC791\uC5C5\uC5D0 \uCD94\uAC00\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",warningsAdditionalMCCOptions:"\uB2E4\uC74C\uC758 \uCD94\uAC00 MCC \uC635\uC158\uC740 \uC9C0\uC6D0\uB418\uC9C0 \uC54A\uC74C: ${0}",webAppCardPreview:"\uC6F9 \uC571 \uCE74\uB4DC \uBBF8\uB9AC\uBCF4\uAE30",webAppPackagingDescription:"Web App Server\uB85C \uBC30\uD3EC \uC2DC \uC571\uC740 \uB2E4\uC74C\uACFC \uAC19\uC774 \uD45C\uC2DC\uB429\uB2C8\uB2E4:"}},"common_deployment_gui-ui/l10n/gen/resources/deployment_common/nls/messages":async(h,T,t)=>{h.exports={root:{addAppToExistingTask:"Add app to a packaging task in an existing project",addAppToTask:"Add app to a packaging task in a new project",addFileLabel:"Add File",addFilesDescription:"Most files will be automatically packaged with your app. Add additional custom files or folders.",addFilesLabel:"Add files required for your app to run",addFolder:"Add Folder",addFoldersLabel:"Add folders with files required for your app to run",analysisFailure:"Analysis failed due to a MATLAB Error",analyzingEnded:"Analysis complete",analyzingMessage:"Analyzing files...",analyzingNotStarted:"Analysis not started",appAppearance:"App Appearance",appCardPreview:"App card preview",appDesigner:"App Designer",appPackagingDescription:"The app will be packaged as a MATLAB toolbox and installed in the Apps tab.",beginBuildMLAPP:"Packaging MATLAB App...",cannotUpgradeOldPRJ:"This project was created in a release prior to R2013b and is not supported in the current release. To access the contents of the project, open it using a version of MATLAB from R2013b to R2024b.",comUnsupportedOnThisPlatform:"Projects that create COM components are not supported on Linux and macOS systems. Use a Windows system to create COM components.",defaultImageTooltip:"Default image",devAndTestLabel:"Test Client",endBuildMLAPP:"MATLAB App packaging complete",errorCreatingProject:"An error occurred while creating the project",errorDialogTitle:"Open Project",excelUnsupportedOnThisPlatform:"Projects that create Excel Add-ins are not supported on Linux and macOS systems. Use a Windows system to create Excel Add-ins.",existingProjectNotification:'A project associated with your app exists at "${0}". Use this project to manage your app sharing workflows and data. \n Note: Required files outside of the project folder will not be included and will need to be added manually.',existingProjectTitle:"App Exists in Project",failedToCreateFile:"Failed to Create File",fileNotInProjectMessage:"The following files must be part of the project for this feature. Would you like to add them to the project? \n${0}",fileNotInProjectTitle:"Files Not in Project",fileNotUnderProjectRootMessage:"The file must be part of the project for this feature. Would you like to copy this file to the project folder?",fileNotUnderProjectRootMessageSave:"The file must be part of the project for this feature. Save the file under the Project Folder.",fileNotUnderProjectRootSpecific:"The following file is not under the Project Folder: ${0}",fileNotUnderProjectRootTitle:"File Not Under Project Folder",filesNotAddedToProjectMessage:"The following files could not be added to the project: \n${0}",filesNotAddedToProjectTitle:"Files Not Added to Project",filesRequiredLabel:"Files required for the app to run",hadoopNotSupported:"Hadoop Compiler projects are no longer supported.  Use standaloneApplicationCompiler to deploy to Hadoop clusters instead.",iconLabel:"Icon",imageTextBrowse:"Browse",imageTextRemove:"Remove",imagesInAppLabel:"Images to be used for app and installer",informationLabel:"The following information about your app will be packaged:",invalidFileMessage:`The following files are not under the project folder.
 \${0}
 Files must be under the project folder to be used by this feature.`,invalidFileTitle:"Invalid File",issuesIdentified:"${0} issues identified",noFilesAdded:"No custom files currently added",notCompatiblePRJ:"${0} is not a MATLAB App, MATLAB Toolbox, MATLAB Compiler, or MATLAB Compiler SDK project",openLogButton:"Open Log",openOutputFolder:"Open Output Folder",package:"Package",packageDialogBuildError:"An error occurred while deploying.",packageDialogBuildSuccess:"Process completed successfully.",packageDialogBuildWithWarnings:"Process completed with warnings.",placeholderAuthorName:"Author name",placeholderCompany:"Company",placeholderDescription:"Description",placeholderEmail:"Email",placeholderName:"Name",placeholderSummary:"Summary",placeholderVersion:"Version",postProjectCreateOne:'Project created successfully. Please refer to the "${0}" document in MATLAB to continue sharing your app.',postProjectCreateTwo:"You may now close this window.",previewDialogTitleMatlabApp:"Configure MATLAB App for Sharing",previewDialogTitleStandaloneApp:"Configure Standalone App for Sharing",previewDialogTitleWebApp:"Configure Web App for Sharing",previewPluginError:"File type must be .mlappinstall or .mltbx",progressMessageMatlabApp:"MATLAB App Packaging Progress",progressMessageStandaloneApp:"Standalone App Packaging Progress",progressMessageWebApp:"Web App Packaging Progress",projectFromFileError:"Unable to create project. Check that the project root location is writeable and not in the MATLAB root folder.",projectMustBeOpen:"A project must be open to use this function",projectShare:"Share using a project",projectShareDialogTitle:"Manage App Sharing with a MATLAB Project",projectShareText:"Not seeing a particular option? Certain properties of shared apps can only be configured using a task in a MATLAB Project.",readyToPackage:"The task is ready to deploy",reanalyzeButtonLabel:"Reanalyze",saveInProject:"Save in project",selectFile:"Select a file",selectFolder:"Select a folder",sel