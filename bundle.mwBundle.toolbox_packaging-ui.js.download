Files must be under the Toolbox Folder and not be excluded in order to be used by the feature.`,invalidFolderCharacters:'Invalid toolbox folder. The toolbox folder may not contain the characters <, >, :, ", , *, |, ?, or &.',invalidToolboxFolder:"Invalid toolbox folder. Specifying a class folder, package folder, or a folder named 'resources' or 'private' is not supported.",javaClasspath:"Java Classpath",javaClasspathPlaceholder:"Select Java archive (JAR) files to add to the Java classpath when the toolbox is installed.",latestVersionLabel:"Latest",manageProjectPath:"Manage Project Path",matlabPath:"MATLAB Path",matlabPathPlaceholder:"No folders will be added to the MATLAB Path when the toolbox is installed.",matlabReleaseMaximum:"Maximum MATLAB Release:",matlabReleaseMinimum:"Minimum MATLAB Release:",matlabReleaseRangeError1:"Minimum release must be before maximum release",matlabReleaseRangeError2:"Maximum release must be after minimum release",missingFolder:"Missing toolbox folder",noAddonsMessage:"No required add-ons detected",noAddonsPlaceholder:"No additional add-on dependencies detected",noAppsPlaceholder:"No apps detected",noFilesPlaceholder:"No files found in toolbox folder",noMatlabPathsDetected:"No MATLAB paths detected",outputSettings:"Output Settings",packageToolbox:"Package Toolbox",packagingToolbox:"Packaging Toolbox",releaseCompatibility:"Release Compatibility",reopenToolboxTask:"Reopen Toolbox Task",requiredAddons:"Required Add-ons",requiredFilesMessage:"These files are required by the toolbox but are either not in the toolbox folder or excluded from the toolbox.",resetToolboxFolderConfirmMessage:"Changing the toolbox folder may reset selected toolbox files, apps, path configurations, and documentation. Do you want to continue?",resetToolboxFolderConfirmTitle:"Set New Toolbox Folder?",restoreDefaultPath:"Restore Default Path",selectApps:"Select apps to add to the MATLAB App Gallery when the toolbox is installed.",selectJARFiles:"Select JAR Files",supp