            :host {
                display: block;
            }

            :host([vertical]) {
                display: inline-block;
            }

            :host > div {
                width: 100%;
                height: 100%;
            }

            :host([vertical]) > div {
                border-top: none;
                border-left: 1px solid var(--mw-borderColor-secondary);
            }

            :host > div.mw-menu {
                display: grid;
                border: none;
                grid-template-columns: [gutter] var(--separator-gutter-size) [separator] auto;
            }

            :host > div.mw-menu [part=gutter] {
                grid-column: gutter;
                background-color: var(--separator-gutter-color);
            }

            :host > div.mw-menu [part=separator] {
                grid-column: separator;
                border-top: 1px solid var(--mw-borderColor-secondary);
            }

            :host > div.mw-combobox {
                display: none;
            }

            :host > div.mw-menu-collapsible-area,
            :host > div.mw-menu-focused-area,
            :host > div.mw-menu-area,
            :host > div.mw-menu-empty {
                display: block;
                position: relative;
                height: 1px;
                padding-left: var(--separator-gutter-size);
                box-sizing: border-box;
            }

            :host > div.mw-menu-collapsible-area [part=separator],
            :host > div.mw-menu-focused-area [part=separator],
            :host > div.mw-menu-area [part=separator],
            :host > div.mw-menu-empty [part=separator] {
